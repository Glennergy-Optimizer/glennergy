[Unit]
Description=Glennergy energy algorithm
Requires=glennergy-inputcache.service
After=glennergy-inputcache.service
PartOf=glennergy.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=glennergy
Group=glennergy
UMask=0007
ExecStart=/usr/local/libexec/glennergy/Glennergy-Algoritm
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

StandardOutput=journal
StandardError=journal
SyslogLevelPrefix=true
SyslogIdentifier=glennergy-algorithm

NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=glennergy.target
